APP_ENV=development
LOG_LEVEL=info
VULNAGENT_PROFILE=v03-source
MAX_AGENT_STEPS=15
MAX_ROUTE_REPEATS=2
MAX_ANALYSIS_RETRIES=1
STORAGE_BACKEND=memory
SQLITE_PATH=artifacts/vulnagent.db
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.2
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
# Cost values are estimates per 1M tokens, reviewed on 2026-09-11.
# DeepSeek Flash peak/off-peak USD rates are selected from UTC call time.
# Fill all three values only to override that versioned automatic schedule.
DEEPSEEK_INPUT_COST_PER_MILLION=
DEEPSEEK_CACHED_INPUT_COST_PER_MILLION=
DEEPSEEK_OUTPUT_COST_PER_MILLION=
DEEPSEEK_COST_CURRENCY=USD
# GLM-5.2 public pay-as-you-go rates (CNY).
GLM_INPUT_COST_PER_MILLION=8
GLM_CACHED_INPUT_COST_PER_MILLION=2
GLM_OUTPUT_COST_PER_MILLION=28
GLM_COST_CURRENCY=CNY
# Kimi K2.6 public rates (CNY).
KIMI_INPUT_COST_PER_MILLION=6.5
KIMI_CACHED_INPUT_COST_PER_MILLION=1.1
KIMI_OUTPUT_COST_PER_MILLION=27
KIMI_COST_CURRENCY=CNY
LLM_TIMEOUT_SECONDS=30
